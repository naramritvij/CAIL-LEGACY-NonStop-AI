# "mock" showcases a separate fictional incident set. "http" uses the actual local synthetic FastAPI backend.
# The Docker Compose configuration sets http mode explicitly.
VITE_LEGACY_DATA_MODE=http
# Base path for the FastAPI routes.
VITE_API_BASE=/api/v1
# Dev-server proxy target for /api when running in http mode (not exposed to the browser).
LEGACY_API_PROXY_TARGET=http://localhost:8000
