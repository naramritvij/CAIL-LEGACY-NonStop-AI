# Never commit secrets. Set fresh 20+ character values in a private .env file.
LEGACY_EXPERT_KEY=
LEGACY_REVIEWER_KEY=

# New single-assistant workspace. Local mode is a single demonstration identity.
# Setting USERS disables local fallback; keys require 32+ unique characters.
# Example shape only (supply fresh private values, never commit keys):
# CAIL_WORKSPACE_USERS='[{"id":"operator-id","name":"Operator Name","key":"<fresh-32+-character-key>","can_read_live":true,"can_review":false}]'
CAIL_WORKSPACE_LOCAL_DEMO=true
CAIL_WORKSPACE_LOCAL_NAME=Local operator
CAIL_WORKSPACE_USERS=[]
CAIL_KNOWLEDGE_RELEASE=L23.08

# OPTIONAL, disabled by default. Requires an authorized HTTPS source gateway.
# Gateway JSON contract: source_id, system_id, observed_at (ISO 8601 with zone),
# health (ok|warning|critical|unknown), records (array of <=100 bounded objects).
CAIL_LIVE_ENABLED=false
CAIL_OPERATOR_READ_KEY=
CAIL_LIVE_ALLOWED_HOSTS=
CAIL_LIVE_PROGNOSIS_URL=
CAIL_LIVE_PROGNOSIS_TOKEN=
CAIL_LIVE_PROGNOSIS_TOPOLOGY_URL=
# Optional direct Prognosis REST dataset (takes precedence over its topology gateway).
CAIL_PROGNOSIS_DATASET_URL=
CAIL_PROGNOSIS_USER=
CAIL_PROGNOSIS_PASSWORD=
CAIL_PROGNOSIS_SYSTEM_ID=
CAIL_PROGNOSIS_FIELDS={}
CAIL_PROGNOSIS_ROWS_KEY=
# Optional newest MOMI alarm export, read-only. In Docker use /readonly-momi.
CAIL_MOMI_EXPORT_DIR=
CAIL_MOMI_SYSTEM_ID=
CAIL_MOMI_EXPORT_HOST_DIR=./data/momi-inbox
CAIL_LIVE_MOMI_URL=
CAIL_LIVE_MOMI_TOKEN=
CAIL_LIVE_MOMI_TOPOLOGY_URL=
CAIL_LIVE_ASAP_URL=
CAIL_LIVE_ASAP_TOKEN=
CAIL_LIVE_ASAP_TOPOLOGY_URL=
CAIL_LIVE_EMS_URL=
CAIL_LIVE_EMS_TOKEN=
CAIL_LIVE_SCF_URL=
CAIL_LIVE_SCF_TOKEN=
CAIL_LIVE_GUARDIAN_URL=
CAIL_LIVE_GUARDIAN_TOKEN=
CAIL_LIVE_PATHWAY_URL=
CAIL_LIVE_PATHWAY_TOKEN=
